---
import { Code } from 'astro:components';

export interface Props {
	title?: string;
	code: string;
	lang?: string;
}

const { title, code, lang = 'text' } = Astro.props;
const codeText = code.trim();
const langLabel = lang.toUpperCase();
const copyLabel = title ? 'Copy ' + title : 'Copy code';
---

<figure class="ria-code-block ria-terminal" data-ria-code-block>
	<figcaption>
		<span>{title ?? langLabel}</span>
		<button type="button" aria-label={copyLabel} title="Copy code" data-ria-copy-button>
			<svg aria-hidden="true" viewBox="0 0 24 24">
				<rect x="9" y="9" width="10" height="10" rx="2"></rect>
				<path d="M5 15V7a2 2 0 0 1 2-2h8"></path>
			</svg>
		</button>
	</figcaption>
	<Code code={codeText} lang={lang} themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
</figure>

<script>
	function fallbackCopy(text) {
		const textarea = document.createElement('textarea');
		textarea.value = text;
		textarea.setAttribute('readonly', '');
		textarea.style.position = 'fixed';
		textarea.style.inset = '0 auto auto 0';
		textarea.style.opacity = '0';
		document.body.append(textarea);
		textarea.select();
		document.execCommand('copy');
		textarea.remove();
	}

	function initCodeBlocks() {
		for (const root of document.querySelectorAll('[data-ria-code-block]:not([data-copy-ready])')) {
			root.setAttribute('data-copy-ready', 'true');
			const button = root.querySelector('[data-ria-copy-button]');
			const pre = root.querySelector('pre');
			if (!(button instanceof HTMLButtonElement) || !pre) continue;

			button.addEventListener('click', async () => {
				const text = pre.innerText;
				try {
					if (navigator.clipboard?.writeText) {
						await navigator.clipboard.writeText(text);
					} else {
						fallbackCopy(text);
					}
					button.dataset.copyState = 'copied';
					window.setTimeout(() => {
						delete button.dataset.copyState;
					}, 1400);
				} catch {
					try {
						fallbackCopy(text);
						button.dataset.copyState = 'copied';
						window.setTimeout(() => {
							delete button.dataset.copyState;
						}, 1400);
					} catch {
						button.dataset.copyState = 'failed';
						window.setTimeout(() => {
							delete button.dataset.copyState;
						}, 1400);
					}
				}
			});
		}
	}

	initCodeBlocks();
	document.addEventListener('astro:page-load', initCodeBlocks);
</script>

<style>
	.ria-code-block {
		overflow: hidden;
		margin: 1.25rem 0;
	}

	.ria-code-block figcaption {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		border-bottom: 1px solid var(--ria-border-subtle);
		padding: 0.65rem 0.8rem 0.65rem 1rem;
		background: rgba(255, 255, 255, 0.035);
	}

	.ria-code-block figcaption span {
		min-width: 0;
		overflow: hidden;
		color: var(--ria-secondary);
		font: 700 0.72rem/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		letter-spacing: 0.08em;
		text-overflow: ellipsis;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.ria-code-block button {
		display: inline-grid;
		flex: 0 0 auto;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border: 1px solid var(--ria-border-subtle);
		border-radius: 8px;
		background: var(--ria-neutral-surface-raised);
		color: var(--ria-text-secondary);
		cursor: pointer;
		transition:
			border-color 160ms ease,
			color 160ms ease,
			background 160ms ease;
	}

	.ria-code-block button:hover {
		border-color: var(--ria-secondary);
		color: var(--ria-secondary);
	}

	.ria-code-block button[data-copy-state='copied'] {
		border-color: var(--ria-success);
		color: var(--ria-success);
	}

	.ria-code-block button[data-copy-state='failed'] {
		border-color: var(--ria-danger);
		color: var(--ria-danger);
	}

	.ria-code-block svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
	}

	.ria-code-block :global(pre.astro-code) {
		margin: 0;
		border-radius: 0;
		background: var(--ria-code-bg) !important;
		padding: 1rem;
		overflow-x: auto;
	}

	.ria-code-block :global(pre.astro-code code) {
		display: block;
		min-width: max-content;
		font-size: 0.88rem;
		line-height: 1.6;
	}
</style>
